{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "outDir": "static/js",
    "rootDir": "compiler",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["compiler/**/*.ts"]
}